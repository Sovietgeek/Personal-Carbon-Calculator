# ================================================================
# EcoVerse — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file with real secrets to Git.
# ================================================================

# --- PostgreSQL ---
POSTGRES_DB=ecoverse
POSTGRES_USER=ecoverse
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_PORT=5432

# --- Backend ---
BACKEND_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# --- JWT (REQUIRED — must be at least 256 bits) ---
# Generate with: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_256_BITS_LONG

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8081

# --- Google OAuth2 ---
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add redirect URI: http://localhost:8081/login/oauth2/code/google
# 4. Copy Client ID and Secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SMTP) ---
# Local dev: use MailHog (docker-compose includes it) — no real SMTP needed.
# MailHog Web UI: http://localhost:8025
# For production (Gmail): set MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=your@email.com, MAIL_PASSWORD=app-password,
# MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@ecoverse.app
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- App URL (used for email links) ---
APP_URL=http://localhost:8081

# --- External APIs ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
RSS2JSON_BASE_URL=https://api.rss2json.com/v1/api.json

# --- Gemini AI (Get free key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# --- NewsAPI (Get key from https://newsapi.org/) ---
NEWSAPI_API_KEY=

# --- Razorpay (Test mode keys from https://dashboard.razorpay.com) ---
# NEVER use LIVE keys in development. Always set RAZORPAY_MODE=test.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CURRENCY=INR
RAZORPAY_MODE=test
