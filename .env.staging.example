# ================================================================
# EcoVerse — Staging Environment Variables
# ================================================================
# This file is a TEMPLATE. Copy to .env.staging and fill in values.
# NEVER commit .env.staging to Git. It is gitignored.
# NEVER use production secrets here.
# ================================================================

# --- PostgreSQL (staging database — separate from dev/prod) ---
POSTGRES_DB=ecoverse_staging
POSTGRES_USER=ecoverse_staging
POSTGRES_PASSWORD=            # REQUIRED: Generate with: openssl rand -base64 24
POSTGRES_PORT=5433           # Different from dev (5432) to avoid conflict

# --- Backend ---
BACKEND_PORT=8082            # Different from dev (8081) to avoid conflict
SPRING_PROFILES_ACTIVE=staging

# --- JWT ---
JWT_SECRET=                  # REQUIRED: Generate with: openssl rand -base64 64 | tr -d '\n'
                             # Must be at least 32 characters. Different from dev/prod.

# --- CORS ---
CORS_ORIGINS=                # REQUIRED: Set to ngrok HTTPS URL, e.g. https://xxxx.ngrok-free.app
                             # NEVER use * in staging. ProductionStartupValidator will reject it.

# --- Cookie ---
COOKIE_SECURE=true           # Always true in staging (ngrok provides HTTPS)
COOKIE_DOMAIN=               # Set if using custom domain, e.g. .ecoverse.app

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=            # Set if testing Google login in staging
GOOGLE_CLIENT_SECRET=        # Set if testing Google login in staging
                             # Configure redirect URI in Google Console: https://<ngrok-url>/login/oauth2/code/google

# --- Razorpay (TEST MODE ONLY) ---
RAZORPAY_KEY_ID=             # Razorpay TEST key ID (starts with rzp_test_)
RAZORPAY_KEY_SECRET=        # Razorpay TEST key secret
RAZORPAY_WEBHOOK_SECRET=    # From Razorpay Dashboard → Webhooks → staging webhook
RAZORPAY_MODE=test           # MUST be "test". NEVER set to "live" in staging.
RAZORPAY_CURRENCY=INR

# --- Email (SMTP) ---
MAIL_HOST=                   # e.g. smtp.gmail.com or smtp.mailtrap.io (or mailhog in docker)
MAIL_PORT=587                # 1025 for MailHog
MAIL_USERNAME=               # SMTP username (empty for MailHog)
MAIL_PASSWORD=               # SMTP password or app-specific password (empty for MailHog)
MAIL_FROM=noreply@ecoverse.app
MAIL_SMTP_AUTH=false         # true when using authenticated SMTP (Gmail/Mailtrap)
MAIL_SMTP_STARTTLS=false     # true when using STARTTLS (Gmail/Mailtrap)

# --- App URL ---
APP_URL=                     # REQUIRED: Set to ngrok HTTPS URL, e.g. https://xxxx.ngrok-free.app

# --- Gemini AI (optional) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash

# --- NewsAPI (optional) ---
NEWSAPI_API_KEY=

# --- External API URLs (usually no change needed) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
RSS2JSON_BASE_URL=https://api.rss2json.com/v1/api.json

# --- ngrok (set after starting ngrok) ---
NGROK_URL=                   # e.g. https://xxxx.ngrok-free.app
                             # Update CORS_ORIGINS and APP_URL after ngrok starts
