token.txt
vtoken.txt
cookies*.txt
auth-*.txt
auth-*.json
ec_cookies*.txt
login*.json
news_*.json
test_*.json
mail.json

# --- ZCode plans (internal) ---
.zcode/

# --- Temp registration files ---
.tmp_reg/

