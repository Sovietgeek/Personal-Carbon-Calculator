# --- Java / Maven ---
target/
*.class
*.jar
*.war

# --- IDE ---
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# --- OS ---
.DS_Store
Thumbs.db
nul

# --- Environment (contains secrets!) ---
.env
.env.local
.env.production

# --- Database ---
data/
*.mv.db
*.trace.db

# --- Logs ---
*.log
logs/

# --- Docker ---
docker-compose.override.yml

# --- Uploads ---
uploads/

